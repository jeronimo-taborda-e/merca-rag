graph ERD {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", fontsize=22, labelloc=t, label="Zona A – Núcleo comercial", pad=0.3, dpi=170, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica-Bold", fontsize=13, color=black];
  n_Categoría [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Categoría", fontsize=14, margin="0.18,0.1"];
  n_Categoría_id_categoria [shape=ellipse, label=<<U>id_categoria</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Categoría -- n_Categoría_id_categoria [penwidth=0.8];
  n_Cliente [shape=box, style="dashed,filled", fillcolor="#f3f3f3", color="#777777", fontcolor="#555555", label="Cliente\n(zona B)", fontsize=12];
  n_Compra [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Compra", fontsize=14, margin="0.18,0.1"];
  n_Compra_id_compra [shape=ellipse, label=<<U>id_compra</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Compra -- n_Compra_id_compra [penwidth=0.8];
  n_Detalle_Compra [shape=box, label="Detalle Compra", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Detalle_Compra_id_compra [shape=ellipse, label=<<U>id_compra</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Detalle_Compra -- n_Detalle_Compra_id_compra [penwidth=0.8];
  n_Detalle_Compra_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Detalle_Compra -- n_Detalle_Compra_id_producto [penwidth=0.8];
  n_Inventario [shape=box, label="Inventario", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Inventario_id_punto_venta [shape=ellipse, label=<<U>id_punto_venta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Inventario -- n_Inventario_id_punto_venta [penwidth=0.8];
  n_Inventario_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Inventario -- n_Inventario_id_producto [penwidth=0.8];
  n_Marca [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Marca", fontsize=14, margin="0.18,0.1"];
  n_Marca_id_marca [shape=ellipse, label=<<U>id_marca</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Marca -- n_Marca_id_marca [penwidth=0.8];
  n_Producto [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Producto", fontsize=14, margin="0.18,0.1"];
  n_Producto_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Producto -- n_Producto_id_producto [penwidth=0.8];
  n_Promoción [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Promoción", fontsize=14, margin="0.18,0.1"];
  n_Promoción_id_promocion [shape=ellipse, label=<<U>id_promocion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción -- n_Promoción_id_promocion [penwidth=0.8];
  n_Promoción_Producto [shape=box, label="Promoción Producto", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Promoción_Producto_id_promocion [shape=ellipse, label=<<U>id_promocion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción_Producto -- n_Promoción_Producto_id_promocion [penwidth=0.8];
  n_Promoción_Producto_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción_Producto -- n_Promoción_Producto_id_producto [penwidth=0.8];
  n_Proveedor [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Proveedor", fontsize=14, margin="0.18,0.1"];
  n_Proveedor_id_proveedor [shape=ellipse, label=<<U>id_proveedor</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Proveedor -- n_Proveedor_id_proveedor [penwidth=0.8];
  n_Punto_de_Venta [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Punto de Venta", fontsize=14, margin="0.18,0.1"];
  n_Punto_de_Venta_id_punto_venta [shape=ellipse, label=<<U>id_punto_venta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Punto_de_Venta -- n_Punto_de_Venta_id_punto_venta [penwidth=0.8];
  r0_A [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se clasifica en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Categoría -- r0_A [label="1"];
  r0_A -- n_Producto [label="N", color="black:white:black", penwidth=1.2];
  r1_A [shape=diamond, style=filled, fillcolor="#cfe2f3", label="tiene", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Marca -- r1_A [label="1"];
  r1_A -- n_Producto [label="N", color="black:white:black", penwidth=1.2];
  r2_A [shape=diamond, style=filled, fillcolor="#cfe2f3", label="suministra", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Proveedor -- r2_A [label="1"];
  r2_A -- n_Producto [label="N", color="black:white:black", penwidth=1.2];
  r3_A [shape=diamond, style=filled, fillcolor="#cfe2f3", label="registra", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Punto_de_Venta -- r3_A [label="1"];
  r3_A -- n_Compra [label="N", color="black:white:black", penwidth=1.2];
  r4_A [shape=diamond, style=filled, fillcolor="#cfe2f3", label="realiza", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Cliente -- r4_A [label="1"];
  r4_A -- n_Compra [label="N", color="black:white:black", penwidth=1.2];
  n_Producto -- n_Inventario [label="N"];
  n_Punto_de_Venta -- n_Inventario [label="M"];
  n_Promoción -- n_Promoción_Producto [label="N", color="black:white:black", penwidth=1.2];
  n_Producto -- n_Promoción_Producto [label="M"];
  n_Compra -- n_Detalle_Compra [label="N", color="black:white:black", penwidth=1.2];
  n_Producto -- n_Detalle_Compra [label="M"];
}