graph ERD {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", fontsize=22, labelloc=t, label="Zona C – Capa RAG y vectorial", pad=0.3, dpi=170, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica-Bold", fontsize=13, color=black];
  n_Consulta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Consulta", fontsize=14, margin="0.18,0.1"];
  n_Consulta_id_consulta [shape=ellipse, label=<<U>id_consulta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Consulta -- n_Consulta_id_consulta [penwidth=0.8];
  n_Documento [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Documento", fontsize=14, margin="0.18,0.1"];
  n_Documento_id_doc [shape=ellipse, label=<<U>id_doc</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Documento -- n_Documento_id_doc [penwidth=0.8];
  n_Embeddings_Imagen [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Embeddings Imagen", fontsize=14, margin="0.18,0.1"];
  n_Embeddings_Imagen_id_embedding [shape=ellipse, label=<<U>id_embedding</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Embeddings_Imagen -- n_Embeddings_Imagen_id_embedding [penwidth=0.8];
  n_Embeddings_Texto [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Embeddings Texto", fontsize=14, margin="0.18,0.1"];
  n_Embeddings_Texto_id_embedding [shape=ellipse, label=<<U>id_embedding</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Embeddings_Texto -- n_Embeddings_Texto_id_embedding [penwidth=0.8];
  n_Embeddings_Texto_CLIP [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Embeddings Texto CLIP", fontsize=14, margin="0.18,0.1"];
  n_Embeddings_Texto_CLIP_id_embedding [shape=ellipse, label=<<U>id_embedding</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Embeddings_Texto_CLIP -- n_Embeddings_Texto_CLIP_id_embedding [penwidth=0.8];
  n_Etiqueta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Etiqueta", fontsize=14, margin="0.18,0.1"];
  n_Etiqueta_id_etiqueta [shape=ellipse, label=<<U>id_etiqueta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Etiqueta -- n_Etiqueta_id_etiqueta [penwidth=0.8];
  n_Evaluación [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Evaluación", fontsize=14, margin="0.18,0.1"];
  n_Evaluación_id_eval [shape=ellipse, label=<<U>id_eval</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Evaluación -- n_Evaluación_id_eval [penwidth=0.8];
  n_Imagen [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Imagen", fontsize=14, margin="0.18,0.1"];
  n_Imagen_id_img [shape=ellipse, label=<<U>id_img</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Imagen -- n_Imagen_id_img [penwidth=0.8];
  n_Imagen_Etiqueta [shape=box, label="Imagen Etiqueta", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Imagen_Etiqueta_id_img [shape=ellipse, label=<<U>id_img</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Imagen_Etiqueta -- n_Imagen_Etiqueta_id_img [penwidth=0.8];
  n_Imagen_Etiqueta_id_etiqueta [shape=ellipse, label=<<U>id_etiqueta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Imagen_Etiqueta -- n_Imagen_Etiqueta_id_etiqueta [penwidth=0.8];
  n_Pregunta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Pregunta", fontsize=14, margin="0.18,0.1"];
  n_Pregunta_id_pregunta [shape=ellipse, label=<<U>id_pregunta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Pregunta -- n_Pregunta_id_pregunta [penwidth=0.8];
  n_Pregunta_Documento [shape=box, label="Pregunta Documento", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Pregunta_Documento_id_pregunta [shape=ellipse, label=<<U>id_pregunta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Pregunta_Documento -- n_Pregunta_Documento_id_pregunta [penwidth=0.8];
  n_Pregunta_Documento_id_doc [shape=ellipse, label=<<U>id_doc</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Pregunta_Documento -- n_Pregunta_Documento_id_doc [penwidth=0.8];
  n_Producto [shape=box, style="dashed,filled", fillcolor="#f3f3f3", color="#777777", fontcolor="#555555", label="Producto\n(zona A)", fontsize=12];
  n_Query_Embeddings [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Query Embeddings", fontsize=14, margin="0.18,0.1"];
  n_Query_Embeddings_id_qemb [shape=ellipse, label=<<U>id_qemb</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Query_Embeddings -- n_Query_Embeddings_id_qemb [penwidth=0.8];
  n_Resultado [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Resultado", fontsize=14, margin="0.18,0.1"];
  n_Resultado_id_resultado [shape=ellipse, label=<<U>id_resultado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Resultado -- n_Resultado_id_resultado [penwidth=0.8];
  n_Usuario [shape=box, style="dashed,filled", fillcolor="#f3f3f3", color="#777777", fontcolor="#555555", label="Usuario\n(zona B)", fontsize=12];
  r0_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="describe", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Producto -- r0_C [label="1"];
  r0_C -- n_Documento [label="N"];
  r1_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="contiene", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Documento -- r1_C [label="1"];
  r1_C -- n_Imagen [label="N", color="black:white:black", penwidth=1.2];
  r2_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se divide en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Documento -- r2_C [label="1"];
  r2_C -- n_Embeddings_Texto [label="N", color="black:white:black", penwidth=1.2];
  r3_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="vectoriza", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Imagen -- r3_C [label="1", color="black:white:black", penwidth=1.2];
  r3_C -- n_Embeddings_Imagen [label="1", color="black:white:black", penwidth=1.2];
  r4_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="formula", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Usuario -- r4_C [label="1"];
  r4_C -- n_Consulta [label="N", color="black:white:black", penwidth=1.2];
  r5_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se ejecuta como", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Pregunta -- r5_C [label="1"];
  r5_C -- n_Consulta [label="N"];
  r6_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="vectoriza", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Consulta -- r6_C [label="1", color="black:white:black", penwidth=1.2];
  r6_C -- n_Query_Embeddings [label="1", color="black:white:black", penwidth=1.2];
  r7_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="recupera", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Consulta -- r7_C [label="1"];
  r7_C -- n_Resultado [label="N", color="black:white:black", penwidth=1.2];
  r8_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="aparece en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Embeddings_Texto -- r8_C [label="1"];
  r8_C -- n_Resultado [label="N"];
  r9_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="aparece en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Imagen -- r9_C [label="1"];
  r9_C -- n_Resultado [label="N"];
  r10_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se evalúa en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Consulta -- r10_C [label="1"];
  r10_C -- n_Evaluación [label="1", color="black:white:black", penwidth=1.2];
  r11_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se proyecta en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Embeddings_Texto -- r11_C [label="1"];
  r11_C -- n_Embeddings_Texto_CLIP [label="1", color="black:white:black", penwidth=1.2];
  n_Imagen -- n_Imagen_Etiqueta [label="N"];
  n_Etiqueta -- n_Imagen_Etiqueta [label="M"];
  n_Pregunta -- n_Pregunta_Documento [label="N", color="black:white:black", penwidth=1.2];
  n_Documento -- n_Pregunta_Documento [label="M"];
  xor_note [shape=note, style=filled, fillcolor="#fffbe6", fontsize=10, label="XOR: cada Resultado proviene\nde un chunk (Embeddings Texto)\no de una Imagen, nunca de ambos"];
  xor_note -- n_Resultado [style=dotted];
}