graph ERD {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", fontsize=22, labelloc=t, label="Zona B – Personas y domicilios", pad=0.3, dpi=170, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica-Bold", fontsize=13, color=black];
  n_Administrativo [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Administrativo", fontsize=14, margin="0.18,0.1"];
  n_Administrativo_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Administrativo -- n_Administrativo_id_empleado [penwidth=0.8];
  n_Cliente [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Cliente", fontsize=14, margin="0.18,0.1"];
  n_Cliente_id_cliente [shape=ellipse, label=<<U>id_cliente</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Cliente -- n_Cliente_id_cliente [penwidth=0.8];
  n_Compra [shape=box, style="dashed,filled", fillcolor="#f3f3f3", color="#777777", fontcolor="#555555", label="Compra\n(zona A)", fontsize=12];
  n_Conductor [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Conductor", fontsize=14, margin="0.18,0.1"];
  n_Conductor_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Conductor -- n_Conductor_id_empleado [penwidth=0.8];
  n_Dirección [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Dirección", fontsize=14, margin="0.18,0.1"];
  n_Dirección_id_direccion [shape=ellipse, label=<<U>id_direccion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Dirección -- n_Dirección_id_direccion [penwidth=0.8];
  n_Domicilio [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Domicilio", fontsize=14, margin="0.18,0.1"];
  n_Domicilio_id_domicilio [shape=ellipse, label=<<U>id_domicilio</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Domicilio -- n_Domicilio_id_domicilio [penwidth=0.8];
  n_Empleado [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Empleado", fontsize=14, margin="0.18,0.1"];
  n_Empleado_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Empleado -- n_Empleado_id_empleado [penwidth=0.8];
  n_Punto_de_Venta [shape=box, style="dashed,filled", fillcolor="#f3f3f3", color="#777777", fontcolor="#555555", label="Punto de Venta\n(zona A)", fontsize=12];
  n_Usuario [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Usuario", fontsize=14, margin="0.18,0.1"];
  n_Usuario_id_usuario [shape=ellipse, label=<<U>id_usuario</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Usuario -- n_Usuario_id_usuario [penwidth=0.8];
  n_Vehículo [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Vehículo", fontsize=14, margin="0.18,0.1"];
  n_Vehículo_id_vehiculo [shape=ellipse, label=<<U>id_vehiculo</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Vehículo -- n_Vehículo_id_vehiculo [penwidth=0.8];
  r0_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="trabaja en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Punto_de_Venta -- r0_B [label="1"];
  r0_B -- n_Empleado [label="N", color="black:white:black", penwidth=1.2];
  r1_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="dispone de", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Punto_de_Venta -- r1_B [label="1"];
  r1_B -- n_Vehículo [label="N", color="black:white:black", penwidth=1.2];
  r2_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="registra", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Cliente -- r2_B [label="1"];
  r2_B -- n_Dirección [label="N", color="black:white:black", penwidth=1.2];
  r3_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="genera", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Compra -- r3_B [label="1"];
  r3_B -- n_Domicilio [label="1", color="black:white:black", penwidth=1.2];
  r4_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se entrega en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Dirección -- r4_B [label="1"];
  r4_B -- n_Domicilio [label="N", color="black:white:black", penwidth=1.2];
  r5_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="entrega", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Conductor -- r5_B [label="1"];
  r5_B -- n_Domicilio [label="N"];
  r6_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se usa en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Vehículo -- r6_B [label="1"];
  r6_B -- n_Domicilio [label="N"];
  isa0 [shape=triangle, style=filled, fillcolor="#fff2cc", label="ISA\nd", fontsize=11, orientation=90, width=0.9, height=0.8, fixedsize=true];
  n_Usuario -- isa0 [color="black:white:black", penwidth=1.2];
  isa0 -- n_Cliente [dir=forward, arrowhead=none, arrowtail=none];
  isa0 -- n_Empleado [dir=forward, arrowhead=none, arrowtail=none];
  isa1 [shape=triangle, style=filled, fillcolor="#fff2cc", label="ISA\nd", fontsize=11, orientation=90, width=0.9, height=0.8, fixedsize=true];
  n_Empleado -- isa1 [color="black:white:black", penwidth=1.2];
  isa1 -- n_Administrativo [dir=forward, arrowhead=none, arrowtail=none];
  isa1 -- n_Conductor [dir=forward, arrowhead=none, arrowtail=none];
}