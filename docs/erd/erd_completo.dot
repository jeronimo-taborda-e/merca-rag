  n_Pregunta_Documento [shape=box, label="Pregunta Documento", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Pregunta_Documento_id_pregunta [shape=ellipse, label=<<U>id_pregunta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Pregunta_Documento -- n_Pregunta_Documento_id_pregunta [penwidth=0.8];
  n_Pregunta_Documento_id_doc [shape=ellipse, label=<<U>id_doc</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Pregunta_Documento -- n_Pregunta_Documento_id_doc [penwidth=0.8];
  n_Producto [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Producto", fontsize=14, margin="0.18,0.1"];
  n_Producto_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Producto -- n_Producto_id_producto [penwidth=0.8];
  n_Promoción [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Promoción", fontsize=14, margin="0.18,0.1"];
  n_Promoción_id_promocion [shape=ellipse, label=<<U>id_promocion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción -- n_Promoción_id_promocion [penwidth=0.8];
  n_Promoción_Producto [shape=box, label="Promoción Producto", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Promoción_Producto_id_promocion [shape=ellipse, label=<<U>id_promocion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción_Producto -- n_Promoción_Producto_id_promocion [penwidth=0.8];
  n_Promoción_Producto_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Promoción_Producto -- n_Promoción_Producto_id_producto [penwidth=0.8];
  n_Proveedor [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Proveedor", fontsize=14, margin="0.18,0.1"];
  n_Proveedor_id_proveedor [shape=ellipse, label=<<U>id_proveedor</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Proveedor -- n_Proveedor_id_proveedor [penwidth=0.8];
  n_Punto_de_Venta [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Punto de Venta", fontsize=14, margin="0.18,0.1"];
  n_Punto_de_Venta_id_punto_venta [shape=ellipse, label=<<U>id_punto_venta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Punto_de_Venta -- n_Punto_de_Venta_id_punto_venta [penwidth=0.8];
  n_Query_Embeddings [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Query Embeddings", fontsize=14, margin="0.18,0.1"];
  n_Query_Embeddings_id_qemb [shape=ellipse, label=<<U>id_qemb</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Query_Embeddings -- n_Query_Embeddings_id_qemb [penwidth=0.8];
  n_Resultado [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Resultado", fontsize=14, margin="0.18,0.1"];
  n_Resultado_id_resultado [shape=ellipse, label=<<U>id_resultado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Resultado -- n_Resultado_id_resultado [penwidth=0.8];
  n_Usuario [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Usuario", fontsize=14, margin="0.18,0.1"];
  n_Usuario_id_usuario [shape=ellipse, label=<<U>id_usuario</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Usuario -- n_Usuario_id_usuario [penwidth=0.8];
  n_Vehículo [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Vehículo", fontsize=14, margin="0.18,0.1"];
