  n_Compra -- r8_B [label="1"];
  r8_B -- n_Domicilio [label="1", color="black:white:black", penwidth=1.2];
  r9_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se entrega en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Dirección -- r9_B [label="1"];
  r9_B -- n_Domicilio [label="N", color="black:white:black", penwidth=1.2];
