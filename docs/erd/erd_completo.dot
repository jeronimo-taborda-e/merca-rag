  r16_C -- n_Consulta [label="N", color="black:white:black", penwidth=1.2];
  r17_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se ejecuta como", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Pregunta -- r17_C [label="1"];
  r17_C -- n_Consulta [label="N"];
  r18_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="vectoriza", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Consulta -- r18_C [label="1", color="black:white:black", penwidth=1.2];
