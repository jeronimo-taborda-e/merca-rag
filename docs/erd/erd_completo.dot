  n_Embeddings_Texto_CLIP [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Embeddings Texto CLIP", fontsize=14, margin="0.18,0.1"];
  n_Embeddings_Texto_CLIP_id_embedding [shape=ellipse, label=<<U>id_embedding</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
