  n_Consulta -- r19_C [label="1"];
  r19_C -- n_Resultado [label="N", color="black:white:black", penwidth=1.2];
  r20_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="aparece en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Embeddings_Texto -- r20_C [label="1"];
  r20_C -- n_Resultado [label="N"];
  r21_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="aparece en", fontsize=11, height=0.75, margin="0.05,0.02"];
