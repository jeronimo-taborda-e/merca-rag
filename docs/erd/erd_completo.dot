  n_Conductor -- r10_B [label="1"];
  r10_B -- n_Domicilio [label="N"];
  r11_B [shape=diamond, style=filled, fillcolor="#cfe2f3", label="se usa en", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Vehículo -- r11_B [label="1"];
  r11_B -- n_Domicilio [label="N"];
  r12_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="describe", fontsize=11, height=0.75, margin="0.05,0.02"];
  n_Producto -- r12_C [label="1"];
  r12_C -- n_Documento [label="N"];
  r13_C [shape=diamond, style=filled, fillcolor="#cfe2f3", label="contiene", fontsize=11, height=0.75, margin="0.05,0.02"];
