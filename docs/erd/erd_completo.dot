  n_Imagen_Etiqueta_id_etiqueta [shape=ellipse, label=<<U>id_etiqueta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Imagen_Etiqueta -- n_Imagen_Etiqueta_id_etiqueta [penwidth=0.8];
  n_Inventario [shape=box, label="Inventario", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Inventario_id_punto_venta [shape=ellipse, label=<<U>id_punto_venta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Inventario -- n_Inventario_id_punto_venta [penwidth=0.8];
  n_Inventario_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Inventario -- n_Inventario_id_producto [penwidth=0.8];
  n_Marca [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Marca", fontsize=14, margin="0.18,0.1"];
  n_Marca_id_marca [shape=ellipse, label=<<U>id_marca</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Marca -- n_Marca_id_marca [penwidth=0.8];
  n_Pregunta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Pregunta", fontsize=14, margin="0.18,0.1"];
