  n_Promoción -- n_Promoción_Producto [label="N", color="black:white:black", penwidth=1.2];
  n_Producto -- n_Promoción_Producto [label="M"];
  n_Compra -- n_Detalle_Compra [label="N", color="black:white:black", penwidth=1.2];
  n_Producto -- n_Detalle_Compra [label="M"];
  n_Imagen -- n_Imagen_Etiqueta [label="N"];
  n_Etiqueta -- n_Imagen_Etiqueta [label="M"];
  n_Pregunta -- n_Pregunta_Documento [label="N", color="black:white:black", penwidth=1.2];
  n_Documento -- n_Pregunta_Documento [label="M"];
  isa0 [shape=triangle, style=filled, fillcolor="#fff2cc", label="ISA\nd", fontsize=11, orientation=90, width=0.9, height=0.8, fixedsize=true];
  n_Usuario -- isa0 [color="black:white:black", penwidth=1.2];
  isa0 -- n_Cliente [dir=forward, arrowhead=none, arrowtail=none];
  isa0 -- n_Empleado [dir=forward, arrowhead=none, arrowtail=none];
  isa1 [shape=triangle, style=filled, fillcolor="#fff2cc", label="ISA\nd", fontsize=11, orientation=90, width=0.9, height=0.8, fixedsize=true];
  n_Empleado -- isa1 [color="black:white:black", penwidth=1.2];
  isa1 -- n_Administrativo [dir=forward, arrowhead=none, arrowtail=none];
  isa1 -- n_Conductor [dir=forward, arrowhead=none, arrowtail=none];
  xor_note [shape=note, style=filled, fillcolor="#fffbe6", fontsize=10, label="XOR: cada Resultado proviene\nde un chunk (Embeddings Texto)\no de una Imagen, nunca de ambos"];
  xor_note -- n_Resultado [style=dotted];
}