graph ERD {
  graph [layout=dot, rankdir=LR, splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", fontsize=22, labelloc=t, label="MercaRAG – Diagrama entidad-relación completo (Chen, 31 entidades)", pad=0.3, dpi=170, newrank=true];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica-Bold", fontsize=13, color=black];
  n_Administrativo [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Administrativo", fontsize=14, margin="0.18,0.1"];
  n_Administrativo_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Administrativo -- n_Administrativo_id_empleado [penwidth=0.8];
  n_Categoría [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Categoría", fontsize=14, margin="0.18,0.1"];
  n_Categoría_id_categoria [shape=ellipse, label=<<U>id_categoria</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Categoría -- n_Categoría_id_categoria [penwidth=0.8];
  n_Cliente [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Cliente", fontsize=14, margin="0.18,0.1"];
  n_Cliente_id_cliente [shape=ellipse, label=<<U>id_cliente</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Cliente -- n_Cliente_id_cliente [penwidth=0.8];
  n_Compra [shape=box, style="filled", fillcolor="#d9ead3", penwidth=1.6, label="Compra", fontsize=14, margin="0.18,0.1"];
  n_Compra_id_compra [shape=ellipse, label=<<U>id_compra</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Compra -- n_Compra_id_compra [penwidth=0.8];
  n_Conductor [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Conductor", fontsize=14, margin="0.18,0.1"];
  n_Conductor_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Conductor -- n_Conductor_id_empleado [penwidth=0.8];
  n_Consulta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Consulta", fontsize=14, margin="0.18,0.1"];
  n_Consulta_id_consulta [shape=ellipse, label=<<U>id_consulta</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Consulta -- n_Consulta_id_consulta [penwidth=0.8];
  n_Detalle_Compra [shape=box, label="Detalle Compra", image="assoc.png", imagescale=true, fixedsize=true, width=2.0, height=0.7, penwidth=0, fontsize=12];
  n_Detalle_Compra_id_compra [shape=ellipse, label=<<U>id_compra</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Detalle_Compra -- n_Detalle_Compra_id_compra [penwidth=0.8];
  n_Detalle_Compra_id_producto [shape=ellipse, label=<<U>id_producto</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Detalle_Compra -- n_Detalle_Compra_id_producto [penwidth=0.8];
  n_Dirección [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Dirección", fontsize=14, margin="0.18,0.1"];
  n_Dirección_id_direccion [shape=ellipse, label=<<U>id_direccion</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Dirección -- n_Dirección_id_direccion [penwidth=0.8];
  n_Documento [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Documento", fontsize=14, margin="0.18,0.1"];
  n_Documento_id_doc [shape=ellipse, label=<<U>id_doc</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
