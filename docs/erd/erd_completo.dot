  n_Empleado [shape=box, style="filled", fillcolor="#f4cccc", penwidth=1.6, label="Empleado", fontsize=14, margin="0.18,0.1"];
  n_Empleado_id_empleado [shape=ellipse, label=<<U>id_empleado</U>>, fontsize=10, height=0.3, margin="0.04,0.02"];
  n_Empleado -- n_Empleado_id_empleado [penwidth=0.8];
  n_Etiqueta [shape=box, style="filled", fillcolor="#d9d2e9", penwidth=1.6, label="Etiqueta", fontsize=14, margin="0.18,0.1"];
