# Copia este archivo como .env y cambia los valores.
POSTGRES_USER=mercarag
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=mercarag
# Puertos en tu equipo (distintos a los del laboratorio para no chocar)
POSTGRES_HOST_PORT=5434
JUPYTER_PORT=8889
JUPYTER_TOKEN=mercarag
# Opcional: clave de Groq (console.groq.com/keys) para generar respuestas RAG.
# llama-3.3-70b-versatile fue retirado por Groq el 16/08/2026: usar openai/gpt-oss-120b o qwen/qwen3.6-27b
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
